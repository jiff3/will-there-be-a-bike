# Copy to .env before running Docker Compose.
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_PUBLIC_ORIGIN=http://localhost:5173
# Production requires an HTTPS origin and secure cookies; terminate TLS upstream.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168
AUTH_RATE_LIMIT=10
BACKGROUND_JOBS_ENABLED=true
SNAPSHOT_RETENTION_DAYS=30
JOB_RETENTION_DAYS=90
DOCS_ENABLED=true
DB_POOL_SIZE=4
DEMO_MODE=false
# Only the root managed-deployment image serves frontend files itself.
# FRONTEND_DIST_PATH=/app/frontend-dist

POSTGRES_DB=bike_forecast
POSTGRES_USER=bike
POSTGRES_PASSWORD=change-me-for-production
DATABASE_URL=postgresql+asyncpg://bike:change-me-for-production@db:5432/bike_forecast

VITE_API_BASE_URL=/api/v1
# Public MapLibre style URL, bundled at frontend build time in production.
# Preserve provider/data attribution. Never put private credentials in VITE_* variables.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
GBFS_POLL_SECONDS=60

# Optional absolute path inside the backend container to a deployment-approved model pointer.
# ML_ARTIFACT_PATH=/app/app/modules/ml/artifacts/current.json

